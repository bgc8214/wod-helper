# WOD Helper 설정 (선택). 복사해서 .env 로 쓰면 collector 가 읽는다.
#   cp .env.example .env
# 값이 없으면 아래 기본값을 사용한다.

# 수집 대상 지점 idx (1=스타디온 판교, 2=광명, 3=범계). 기본 1.
STADION_BOX_IDX=1

# 페이지에서 강조·기본 펼침할 카테고리 idx (6=DIET/SWEAT CAMP). 기본 6.
HIGHLIGHT_CATEGORY=6

# API 호스트. 기본 http://api.stadion.co.kr:8080
STADION_API_HOST=http://api.stadion.co.kr:8080

# 참고: 현재 WOD 조회는 인증이 필요 없다(runQuery). 로그인 자격증명은 쓰지 않으므로
# .env 에 넣지 않는다. 앱 자체 로그인 정보는 절대 커밋하지 말 것.
