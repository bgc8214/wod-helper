<?xml version="1.0" encoding="UTF-8"?>
<!--
  WOD Helper 자동 수집 launchd 잡. 하루 3회(08:00 / 14:00 / 20:00) 수집.
    아침  = 오늘 확정 / 오후 = 내일 업로드분 / 저녁 = 내일 보정 (PRD 6장)

  설치:
    1) 아래 __PROJECT_DIR__ 를 이 프로젝트 절대경로로 바꾼다.
       예) sed -i '' "s|__PROJECT_DIR__|$PWD|g" scripts/com.wodhelper.collect.plist
    2) cp scripts/com.wodhelper.collect.plist ~/Library/LaunchAgents/
    3) launchctl load ~/Library/LaunchAgents/com.wodhelper.collect.plist
  해제:
    launchctl unload ~/Library/LaunchAgents/com.wodhelper.collect.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wodhelper.collect</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/scripts/collect.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/launchd.err.log</string>
</dict>
</plist>
